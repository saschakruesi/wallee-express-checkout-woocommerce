#!/usr/bin/env bash
# Syntax check (PHP 7.4) and coding standards (PHPCS) in Docker.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -d vendor ]; then
	docker run --rm -v "$PWD":/app -w /app composer:2 install --no-interaction --prefer-dist --ignore-platform-reqs
fi

docker run --rm -v "$PWD":/app -w /app php:7.4-cli sh -c \
	'find plugin -name "*.php" -print0 | xargs -0 -n1 php -l >/dev/null && vendor/bin/phpcs'
