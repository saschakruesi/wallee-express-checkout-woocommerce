#!/usr/bin/env bash
# Runs PHPUnit in Docker (PHP 8.2). Installs Composer dependencies once.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -d vendor ]; then
	docker run --rm -v "$PWD":/app -w /app composer:2 install --no-interaction --prefer-dist --ignore-platform-reqs
fi

docker run --rm -v "$PWD":/app -w /app php:8.2-cli vendor/bin/phpunit "$@"
